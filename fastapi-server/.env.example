PORT=5000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bookstore
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1
JWT_SECRET=change-this-secret
FRONTEND_ORIGIN=*
SKIP_DB_CREATE=0
# Optional: used once at startup to copy old Mongo books/reviews if the Postgres books table is empty
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=Bookinventary
